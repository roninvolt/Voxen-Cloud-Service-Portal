# =================================================================
# Voxen Cloud Services Environment Variables Configuration
# Copy this file to .env and customize secrets for your environment
# =================================================================

# Application Environment
NODE_ENV=production
PORT=5000
APP_URL=http://localhost
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

# PostgreSQL Database Configuration
POSTGRES_USER=docuser
POSTGRES_PASSWORD=voxencloudpassword2026!
POSTGRES_DB=docmanager
DATABASE_URL=postgresql://docuser:voxencloudpassword2026!@postgres:5432/docmanager

# JWT Authentication Secret (Use a strong 64+ char random string in production)
JWT_SECRET=f4a9b83c2e1d0f5e7a9b8c2d1e0f4a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f

# File Upload Limits (in bytes, default 10MB = 10485760)
MAX_FILE_SIZE=10485760

# Storage Provider Strategy: 'local' (Docker volume) or 's3' (AWS S3)
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads

# AWS S3 Cloud Storage Credentials (Only required when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# CI/CD Container Registry & Image Tag
DOCKER_REGISTRY=docker.io/voxen
IMAGE_TAG=latest
